# Local development defaults. Replace DATABASE_URL with a pooled hosted
# PostgreSQL URL in Vercel and set DATABASE_SSL=true there.
DATABASE_URL=postgresql://rate_limiter:rate_limiter_dev@127.0.0.1:5433/rate_limiter
DATABASE_SSL=false
DATABASE_POOL_MAX=20
PORT=4000
CORS_ORIGIN=http://localhost:5173
REQUEST_LOGGING=true
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=5000
